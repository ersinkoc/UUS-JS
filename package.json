{
  "name": "@uusjs/monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Uus.js - A fresh reactive HTML framework",
  "homepage": "https://uusjs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uus-js/uus.git"
  },
  "license": "MIT",
  "author": "Uus.js Team",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo run build",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,md,json}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish",
    "size": "turbo size",
    "prepare": "husky install",
    "security:audit": "pnpm audit --audit-level=moderate",
    "security:fix": "pnpm audit fix"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "happy-dom": "^20.0.2",
    "husky": "^9.0.11",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "terser": "^5.43.1",
    "tsup": "^8.5.0",
    "turbo": "^2.5.5",
    "typescript": "^5.3.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@8.15.1",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
